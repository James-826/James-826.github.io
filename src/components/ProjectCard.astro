---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../utils/date-utils";

interface Props {
	class?: string;
	style?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	description: string;
	status: string;
	repo: string;
}

const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	description,
	status,
	repo,
} = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

const visibleTags = tags.filter((tag) => tag !== "项目");

const statusTone =
	status === "已完成"
		? "bg-emerald-500/15 text-emerald-600 dark:text-emerald-300"
		: status === "进行中"
			? "bg-sky-500/15 text-sky-600 dark:text-sky-300"
			: status === "已放弃"
				? "bg-rose-500/15 text-rose-500 dark:text-rose-300"
				: "bg-[var(--btn-regular-bg)] text-[var(--btn-content)]";
---
<div
	class:list={[
		"group relative flex flex-col gap-3 px-5 py-5 md:px-7 md:py-6 transition hover:bg-[var(--btn-card-bg-hover)]",
		className,
	]}
	style={style}
>
	<div class="flex items-start justify-between gap-3">
		<a
			href={url}
			class="min-w-0 truncate text-lg font-bold text-90 transition hover:text-[var(--primary)] active:text-[var(--title-active)] md:text-xl"
		>
			{title}
		</a>
		{status && (
			<span
				class:list={[
					"shrink-0 rounded-md px-2.5 py-1 text-xs font-semibold",
					statusTone,
				]}
			>
				{status}
			</span>
		)}
	</div>

	<p class="line-clamp-1 pr-2 text-sm text-75">
		{description || entry.data.description}
	</p>

	<div class="flex flex-wrap items-center justify-between gap-3 pt-1">
		<div
			class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-50"
		>
			<span>{formatDateToYYYYMMDD(published)}</span>
			{updated && updated.getTime() !== published.getTime() && (
				<span>更新于 {formatDateToYYYYMMDD(updated)}</span>
			)}
			{visibleTags.length > 0 && (
				<span class="flex flex-wrap items-center gap-2">
					{visibleTags.map((tag) => (
						<span
							class="rounded bg-[var(--btn-regular-bg)] px-2 py-0.5 text-[var(--btn-content)]"
						>
							{tag}
						</span>
					))}
				</span>
			)}
		</div>

		{repo ? (
			<a
				href={repo}
				target="_blank"
				rel="noopener"
				class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-[var(--primary)] opacity-70 transition hover:opacity-100"
			>
				<Icon name="fa6-brands:github" class="text-sm"></Icon>
				查看仓库
			</a>
		) : (
			<a
				href={url}
				class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-50 transition group-hover:text-[var(--primary)]"
			>
				阅读记录
				<Icon
					name="material-symbols:chevron-right-rounded"
					class="text-base"
				></Icon>
			</a>
		)}
	</div>
</div>
